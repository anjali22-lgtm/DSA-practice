class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int n=nums.size();
        int all_xor=0;
        for(int x:nums)  all_xor ^=x;
        if(all_xor != 0) return n;
        for(int i=0;i<n;++i){
            if((all_xor ^nums[i])!=0)
                return n-1;
        }
        return 0;   
    }
};©leetcode
