#include <bits/stdc++.h>
using namespace std;

int n, m;
vector<vector<int>> adj;
vector<bool> visited;

void dfs(int node) {
    stack<int> st;
    st.push(node);
    visited[node] = true;

    while(!st.empty()) {
        int u = st.top(); st.pop();
        for(int v : adj[u]) {
            if(!visited[v]) {
                visited[v] = true;
                st.push(v);
            }
        }
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin >> n >> m;
    adj.assign(n+1, {});
    visited.assign(n+1, false);

    for(int i=0; i<m; i++) {
        int a, b;
        cin >> a >> b;
        adj[a].push_back(b);
        adj[b].push_back(a);
    }

    vector<int> reps; // representatives of each component

    for(int i=1; i<=n; i++) {
        if(!visited[i]) {
            reps.push_back(i);
            dfs(i);
        }
    }

    cout << reps.size() - 1 << "\n";
    for(int i=1; i<(int)reps.size(); i++) {
        cout << reps[i-1] << " " << reps[i] << "\n";
    }
}
