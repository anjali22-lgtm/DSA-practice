#include <bits/stdc++.h>
using namespace std;

using ll = long long;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        ll n;
        cin >> n;

        vector<ll> res;

        ll pow10 = 10;
        while (pow10 <= n) {
            ll div = pow10 + 1;
            if (n % div == 0) {
                res.push_back(n / div);
            }
            // Avoid overflow: multiply carefully
            if (pow10 > n / 10) break;
            pow10 *= 10;
        }

        if (res.empty()) {
            cout << 0 << "\n";
        } else {
            sort(res.begin(), res.end());
            cout << res.size() << "\n";
            for (ll x : res) cout << x << " ";
            cout << "\n";
        }
    }
}
