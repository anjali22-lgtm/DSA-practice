class Solution {
public:
 uint32_t reverseBits(uint32_t n) {  //uin32_t means unsigned integer(mens negative value)
        for (int i = 0; i < 16; ++i) {
            uint32_t j = 31 - i;
            // if bits differ, flip both using XOR
            if (((n >> i) & 1u) != ((n >> j) & 1u)) {
                n ^= (1u << i) | (1u << j);
            }
        }
        return n;
    }
};
